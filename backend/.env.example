# Copy this file to .env before running the Django application locally.
# Never commit the .env file or production credentials.

# Django
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DB_NAME=specsheet
DB_USER=your-local-postgres-user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432